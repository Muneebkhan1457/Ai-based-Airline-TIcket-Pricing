# MLflow / DagsHub Configuration
MLFLOW_TRACKING_URI=https://dagshub.com/<username>/<repo_name>.mlflow
MLFLOW_TRACKING_USERNAME=your_username
MLFLOW_TRACKING_PASSWORD=your_dagshub_token

# Database Connection (AWS RDS PostgreSQL or leave blank for local SQLite fallback)
DATABASE_URL=postgresql://<user>:<password>@<rds_host>:5432/<dbname>
